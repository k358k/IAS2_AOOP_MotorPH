                  <Font name="Segoe UI" size="16" style="0"/>
                </Property>
                <Property name="lineWrap" type="boolean" value="true"/>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="The Employee Personal-Employment Report &#xa;generates a PDF containing detailed information &#xa;for all employees in the system, including their ID, &#xa;full name, gender, birthday, employment status, &#xa;department, supervisor, and job title. &#xa;This report provides a comprehensive overview of &#xa;employee records for HR and management purposes."/>

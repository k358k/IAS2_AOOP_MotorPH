                <Property name="columns" type="int" value="20"/>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Segoe UI" size="16" style="0"/>
                </Property>
                <Property name="lineWrap" type="boolean" value="true"/>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="The Employee Financial Report generates a PDF that &#xa;includes essential financial information for all employees &#xa;in the system. It features details such as employee ID, &#xa;full name, Pag-IBIG, Social Security System (SSS) number, &#xa;Tax Identification Number (TIN), PhilHealth number, &#xa;basic salary, phone number, clothing allowances, and rice &#xa;subsidy. &#xa;This report serves as a valuable resource for payroll &#xa;processing and financial management."/>
              </Properties>
            </Component>
